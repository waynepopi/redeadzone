<Window x:Class="Deadzone.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="440"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Settings" Style="{StaticResource SectionHeadingStyle}" FontSize="18"/>
                <TextBlock Text="Application preferences" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Options Card -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <!-- Start with Windows -->
                    <StackPanel Margin="0,0,0,16">
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Start with Windows"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Checked="StartWithWindowsCheckBox_Checked"
                                  Unchecked="StartWithWindowsCheckBox_Unchecked"/>
                        <TextBlock Text="Launches elevated at logon via Task Scheduler."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="20,4,0,0"/>
                    </StackPanel>

                    <!-- Start minimized to tray -->
                    <StackPanel Margin="0,0,0,16">
                        <CheckBox x:Name="StartMinimizedCheckBox"
                                  Content="Start minimized to tray"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Checked="StartMinimizedCheckBox_Checked"
                                  Unchecked="StartMinimizedCheckBox_Unchecked"/>
                        <TextBlock Text="Only applies when started by Windows at logon."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="20,4,0,0"/>
                    </StackPanel>

                    <!-- Minimize to tray -->
                    <StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheckBox"
                                  Content="Minimize to tray"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Checked="MinimizeToTrayCheckBox_Checked"
                                  Unchecked="MinimizeToTrayCheckBox_Unchecked"/>
                        <TextBlock Text="Minimizing the window hides it to the system tray."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="20,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Close"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="36"
                        MinWidth="100"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
