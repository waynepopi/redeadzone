<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for self-contained Windows x64 release.
  Use: dotnet publish src/Deadzone.App/Deadzone.App.csproj /p:PublishProfile=win-x64
  Or:  .\scripts\package.ps1 -Version 0.1.0
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
