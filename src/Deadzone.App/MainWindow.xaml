<Window x:Class="Deadzone.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deadzone"
        Width="960"
        Height="640"
        MinWidth="900"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="14"
        Foreground="{StaticResource BrushTextPrimary}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="MainWindow_StateChanged">

    <Border Padding="20,12">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header 48px -->
                <RowDefinition Height="48"/>
                <!-- Row 1: Stick cards -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Controller selector bar 44px -->
                <RowDefinition Height="44"/>
                <!-- Row 3: Status card 56px -->
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════
                 ROW 0 — HEADER
            ═══════════════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Deadzone"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Xbox Series X|S Controller Utility"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Settings button -->
                    <Button x:Name="SettingsButton"
                            Content="⚙ SETTINGS"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32" MinWidth="100" FontSize="11"
                            Margin="0,0,10,0"
                            Click="SettingsButton_Click"/>

                    <!-- Controller status pill -->
                    <Border x:Name="ControllerStatusPill"
                            Style="{StaticResource StatusPillStyle}"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ControllerStatusDot"
                                     Width="8" Height="8"
                                     Fill="{StaticResource BrushTextDisabled}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="ControllerStatusText"
                                       Text="Controller disconnected"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════
                 ROW 1 — MAIN STICK AREA
            ═══════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── LEFT STICK CARD ─── -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- 0: Heading -->
                            <RowDefinition Height="Auto"/>  <!-- 1: Subtitle -->
                            <RowDefinition Height="Auto"/>  <!-- 2: Visualizer Viewbox -->
                            <RowDefinition Height="Auto"/>  <!-- 3: Numeric values -->
                            <RowDefinition Height="Auto"/>  <!-- 4: Deadzone label + % -->
                            <RowDefinition Height="Auto"/>  <!-- 5: Slider -->
                            <RowDefinition Height="Auto"/>  <!-- 6: Drift row -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="LEFT STICK"
                                   Style="{StaticResource SectionHeadingStyle}" FontSize="15"/>
                        <TextBlock Grid.Row="1" Text="Radial Deadzone"
                                   Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,1,0,3"/>

                        <!-- Visualizer Canvas in Viewbox -->
                        <Viewbox Grid.Row="2" Height="175" Margin="0,2,0,4" HorizontalAlignment="Center">
                            <Canvas x:Name="LeftStickCanvas"
                                    Width="230" Height="230"
                                    Background="Transparent">

                                <Ellipse x:Name="LeftOuterCircle"
                                         Canvas.Left="10" Canvas.Top="10"
                                         Width="210" Height="210"
                                         Stroke="{StaticResource BrushBorder}"
                                         StrokeThickness="2" Fill="Transparent"/>

                                <Ellipse x:Name="LeftDeadzoneCircle"
                                         Canvas.Left="107" Canvas.Top="107"
                                         Width="16" Height="16"
                                         Fill="{StaticResource BrushDeadzone}"
                                         Opacity="0.85"
                                         Stroke="{StaticResource BrushBorder}"
                                         StrokeThickness="1"/>

                                <Line x:Name="LeftCrosshairHorizontal"
                                      X1="20" Y1="115" X2="210" Y2="115"
                                      Stroke="{StaticResource BrushBorder}" StrokeThickness="1"/>
                                <Line x:Name="LeftCrosshairVertical"
                                      X1="115" Y1="20" X2="115" Y2="210"
                                      Stroke="{StaticResource BrushBorder}" StrokeThickness="1"/>

                                <Ellipse x:Name="LeftRawDot"
                                         Canvas.Left="111" Canvas.Top="111"
                                         Width="8" Height="8"
                                         Fill="Transparent"
                                         Stroke="{StaticResource BrushRawStick}"
                                         StrokeThickness="1.5"/>

                                <Ellipse x:Name="LeftOutputDot"
                                         Canvas.Left="109" Canvas.Top="109"
                                         Width="12" Height="12"
                                         Fill="{StaticResource BrushAccent}"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Numeric values -->
                        <Grid Grid.Row="3" Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RAW" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X " Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                                    <TextBlock x:Name="LeftRawXText" Text="+0.000" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="  Y " Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="6,0,0,0"/>
                                    <TextBlock x:Name="LeftRawYText" Text="+0.000" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OUTPUT" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X " Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                                    <TextBlock x:Name="LeftOutputXText" Text="+0.000" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="  Y " Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="6,0,0,0"/>
                                    <TextBlock x:Name="LeftOutputYText" Text="+0.000" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Deadzone label + percentage -->
                        <Grid Grid.Row="4" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Deadzone"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="LeftDeadzonePercentText"
                                       Grid.Column="1"
                                       Text="8%"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Deadzone Slider -->
                        <Slider x:Name="LeftDeadzoneSlider"
                                Grid.Row="5"
                                Style="{StaticResource DeadzoneSliderStyle}"
                                Height="24"
                                Margin="0,0,0,4"
                                Minimum="0" Maximum="30" Value="8"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="LeftDeadzoneSlider_ValueChanged"/>

                        <!-- Drift Analysis row -->
                        <Grid Grid.Row="6" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LeftAnalyzeDriftButton"
                                    Grid.Column="0"
                                    Content="ANALYZE DRIFT"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="28" MinWidth="105" FontSize="10"
                                    Click="LeftAnalyzeDriftButton_Click"/>
                            <TextBlock x:Name="LeftDriftSuggestionText"
                                       Grid.Column="1"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="6,0"/>
                            <Button x:Name="LeftApplyDriftButton"
                                    Grid.Column="2"
                                    Content="APPLY"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="28" MinWidth="60" FontSize="10"
                                    Visibility="Collapsed"
                                    Click="LeftApplyDriftButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ─── RIGHT STICK CARD ─── -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- 0: Heading -->
                            <RowDefinition Height="Auto"/>  <!-- 1: Subtitle -->
                            <RowDefinition Height="Auto"/>  <!-- 2: Visualizer Viewbox -->
                            <RowDefinition Height="Auto"/>  <!-- 3: Numeric values -->
                            <RowDefinition Height="Auto"/>  <!-- 4: Deadzone label + % -->
                            <RowDefinition Height="Auto"/>  <!-- 5: Slider -->
                            <RowDefinition Height="Auto"/>  <!-- 6: Drift row -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="RIGHT STICK"
                                   Style="{StaticResource SectionHeadingStyle}" FontSize="15"/>
                        <TextBlock Grid.Row="1" Text="Radial Deadzone"
                                   Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,1,0,3"/>

                        <!-- Visualizer Canvas in Viewbox -->
                        <Viewbox Grid.Row="2" Height="175" Margin="0,2,0,4" HorizontalAlignment="Center">
                            <Canvas x:Name="RightStickCanvas"
                                    Width="230" Height="230"
                                    Background="Transparent">

                                <Ellipse x:Name="RightOuterCircle"
                                         Canvas.Left="10" Canvas.Top="10"
                                         Width="210" Height="210"
                                         Stroke="{StaticResource BrushBorder}"
                                         StrokeThickness="2" Fill="Transparent"/>

                                <Ellipse x:Name="RightDeadzoneCircle"
                                         Canvas.Left="107" Canvas.Top="107"
                                         Width="16" Height="16"
                                         Fill="{StaticResource BrushDeadzone}"
                                         Opacity="0.85"
                                         Stroke="{StaticResource BrushBorder}"
                                         StrokeThickness="1"/>

                                <Line x:Name="RightCrosshairHorizontal"
                                      X1="20" Y1="115" X2="210" Y2="115"
                                      Stroke="{StaticResource BrushBorder}" StrokeThickness="1"/>
                                <Line x:Name="RightCrosshairVertical"
                                      X1="115" Y1="20" X2="115" Y2="210"
                                      Stroke="{StaticResource BrushBorder}" StrokeThickness="1"/>

                                <Ellipse x:Name="RightRawDot"
                                         Canvas.Left="111" Canvas.Top="111"
                                         Width="8" Height="8"
                                         Fill="Transparent"
                                         Stroke="{StaticResource BrushRawStick}"
                                         StrokeThickness="1.5"/>

                                <Ellipse x:Name="RightOutputDot"
                                         Canvas.Left="109" Canvas.Top="109"
                                         Width="12" Height="12"
                                         Fill="{StaticResource BrushAccent}"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Numeric values -->
                        <Grid Grid.Row="3" Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RAW" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X " Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                                    <TextBlock x:Name="RightRawXText" Text="+0.000" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="  Y " Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="6,0,0,0"/>
                                    <TextBlock x:Name="RightRawYText" Text="+0.000" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OUTPUT" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X " Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                                    <TextBlock x:Name="RightOutputXText" Text="+0.000" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="  Y " Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="6,0,0,0"/>
                                    <TextBlock x:Name="RightOutputYText" Text="+0.000" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Deadzone label + percentage -->
                        <Grid Grid.Row="4" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Deadzone"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="RightDeadzonePercentText"
                                       Grid.Column="1"
                                       Text="8%"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Deadzone Slider -->
                        <Slider x:Name="RightDeadzoneSlider"
                                Grid.Row="5"
                                Style="{StaticResource DeadzoneSliderStyle}"
                                Height="24"
                                Margin="0,0,0,4"
                                Minimum="0" Maximum="30" Value="8"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="RightDeadzoneSlider_ValueChanged"/>

                        <!-- Drift Analysis row -->
                        <Grid Grid.Row="6" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RightAnalyzeDriftButton"
                                    Grid.Column="0"
                                    Content="ANALYZE DRIFT"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="28" MinWidth="105" FontSize="10"
                                    Click="RightAnalyzeDriftButton_Click"/>
                            <TextBlock x:Name="RightDriftSuggestionText"
                                       Grid.Column="1"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="6,0"/>
                            <Button x:Name="RightApplyDriftButton"
                                    Grid.Column="2"
                                    Content="APPLY"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="28" MinWidth="60" FontSize="10"
                                    Visibility="Collapsed"
                                    Click="RightApplyDriftButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════
                 ROW 2 — CONTROLLER SELECTOR BAR
            ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,0"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Controller"
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox x:Name="ControllerComboBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Height="30"
                              SelectionChanged="ControllerComboBox_SelectionChanged"/>
                    <Button x:Name="RefreshControllersButton"
                            Grid.Column="2"
                            Content="↺ REFRESH"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30" MinWidth="85" FontSize="11"
                            Margin="10,0,0,0"
                            Click="RefreshControllersButton_Click"/>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════
                 ROW 3 — BOTTOM STATUS CARD
            ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical" Margin="0,0,36,0">
                            <TextBlock Text="Status" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ApplicationStatusText"
                                       Text="Ready"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Connection" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ConnectionStatusText"
                                       Text="Disconnected"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="EnableButton"
                            Grid.Column="1"
                            Content="ENABLE"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38" MinWidth="130"
                            VerticalAlignment="Center"
                            Click="EnableButton_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
